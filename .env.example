# Development Relay pairing cache (leave empty until PrivOS pairing)
# PRIVOS_URL=http://localhost:3000
# CLIENT_ID=
# CLIENT_SECRET=
# MCP_APP_ID=

# Optional EmailJS backend configuration
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=

# Optional installation-agent configuration
# PRIVOS_AGENT_BOT_USER_ID=
# PRIVOS_AGENT_BOT_CREDENTIAL=

# Local UI/runtime
# DEV_TUNNEL=localhost
# VITE_PORT=5179
# PORT=3000
# PRIVOS_STANDALONE_IDENTITY_FILE=./privos-standalone-identity.json
