{
  "name": "ai.privos.demo-hr-miniapp-test",
  "version": "1.0.0",
  "type": "module",
  "private": false,
  "description": "HR management app for recruitment, CV screening, lifecycle, payroll, training, documents, and tracked email workflows on PrivOS.",
  "title": "HR Mini app test migrate",
  "icon": "/public/icon.svg",
  "homepage": "https://privos.ai",
  "author": {
    "name": "PrivOS AI",
    "email": "dev@privos.ai",
    "url": "https://privos.ai"
  },
  "license": "MIT",
  "dockerfilePath": "Dockerfile",
  "keywords": [
    "hr",
    "management",
    "mcp",
    "demo",
    "privos",
    "relay",
    "websocket"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PrivOS-AI/privos-demo-hrm-ws"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "vite build && tsx scripts/generate-manifest.ts && npm run manifest:lint",
    "dev": "cross-env PRIVOS_TRANSPORT=relay PRIVOS_DEV_UI=1 tsx src/server.ts",
    "start": "tsx scripts/start.ts",
    "postinstall": "node scripts/patch-app-server-windows.cjs",
    "pair": "tsx scripts/pair.ts",
    "start:relay": "cross-env PRIVOS_TRANSPORT=relay npm start",
    "start:standalone": "cross-env NODE_ENV=production npm start",
    "typecheck": "tsc --noEmit",
    "typecheck:strict-unused": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "verify:fast-pr": "npm run typecheck:strict-unused && npm run test && npm run build && npm run preflight",
    "manifest:lint": "privos-app lint privos-app.json",
    "preflight": "tsx scripts/preflight.ts",
    "package": "bash scripts/package-source.sh",
    "publish:marketplace": "privos-app publish",
    "docker:build": "bash scripts/build-marketplace-image.sh privos-mcp-app-demo:local",
    "docker:run": "docker run --rm --read-only --cap-drop ALL --security-opt no-new-privileges --pids-limit 100 --tmpfs /tmp -e PORT=3000 privos-mcp-app-demo:local"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@privos_ai/app-server": "^0.9.0",
    "docx": "^9.7.1",
    "dotenv": "^17.3.1",
    "tsx": "^4.0.0",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@privos_ai/app-react": "^0.6.0",
    "@types/express": "^5.0.6",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/ws": "^8.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "cross-env": "^10.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
